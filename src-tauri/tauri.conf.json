{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "片刻",
  "version": "0.1.0",
  "identifier": "com.pianke.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../desktop-dist",
    "beforeBundleCommand": "node scripts/run_python.mjs scripts/build_tauri_sidecar.py"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "片刻",
        "width": 1480,
        "height": 980,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb"],
    "category": "Photography",
    "publisher": "Alleyf & zhaoyue4810",
    "homepage": "https://github.com/Alleyf/pianke",
    "copyright": "Copyright (c) 2026 Alleyf & zhaoyue4810",
    "license": "MIT",
    "licenseFile": "installer-assets/license.rtf",
    "shortDescription": "本地照片擂台式选片桌面应用",
    "longDescription": "片刻是面向摄影师与摄影爱好者的本地照片擂台式选片工具。它通过 AI 完成失败片初筛与相似照片分组，再把最终审美决定权留给你。",
    "externalBin": [
      "binaries/pianke-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer-assets/nsis-header.bmp",
        "sidebarImage": "installer-assets/nsis-sidebar.bmp",
        "uninstallerHeaderImage": "installer-assets/nsis-header.bmp"
      }
    }
  }
}
